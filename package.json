{
  "name": "binjson-structures",
  "version": "1.0.0",
  "description": "WASM/C B+ tree, R-tree, text log, and text index data structures, built on the binjson wire format and file model",
  "type": "module",
  "exports": {
    "./wasm": "./wasm/binjson-structures-wasm.js",
    "./providers": "./wasm/providers.js"
  },
  "files": [
    "wasm",
    "src",
    "include",
    "lib",
    "bin"
  ],
  "bin": {
    "bplustree": "bin/bplustree.js",
    "rtree": "bin/rtree.js",
    "textindex": "bin/textindex.js",
    "textlog": "bin/textlog.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:wasm": "./build-wasm.sh",
    "build:worker": "rollup -c rollup.config.js && cp lib/binjson-structures.wasm site/binjson-structures.wasm",
    "prepack": "npm run build:wasm",
    "serve": "http-server -c-1 . -p 8085"
  },
  "keywords": [
    "b-tree",
    "r-tree",
    "spatial-index",
    "text-index",
    "full-text-search",
    "wasm",
    "opfs",
    "binjson"
  ],
  "author": "",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "http-server": "^14.1.1",
    "node-opfs": "^1.2.0",
    "rollup": "^4.31.0",
    "stemmer": "^2.0.1",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fs-ext@2.1.1": true
  }
}
