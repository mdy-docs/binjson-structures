{
  "name": "binjson-structures",
  "version": "1.0.0",
  "description": "WASM/C B+ tree, R-tree, text log, and text index data structures, built on the binjson wire format and file model",
  "type": "module",
  "exports": {
    "./wasm": "./wasm/binjson-structures-wasm.js"
  },
  "files": [
    "wasm",
    "src",
    "include",
    "lib",
    "bin"
  ],
  "bin": {
    "bplustree": "bin/bplustree.js",
    "rtree": "bin/rtree.js",
    "textindex": "bin/textindex.js",
    "textlog": "bin/textlog.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:wasm": "./build-wasm.sh",
    "prepack": "npm run build:wasm"
  },
  "keywords": [
    "b-tree",
    "r-tree",
    "spatial-index",
    "text-index",
    "full-text-search",
    "wasm",
    "opfs",
    "binjson"
  ],
  "author": "",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "node-opfs": "^1.2.0",
    "stemmer": "^2.0.1",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fs-ext@2.1.1": true
  }
}
